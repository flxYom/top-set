{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/entrainement/carnet-musculation-eps",
      "destination": "/carnet-de-musculation",
      "permanent": true
    },
    {
      "source": "/icon.svg",
      "destination": "/icons/icon.svg",
      "permanent": true
    },
    {
      "source": "/favicon-16.png",
      "destination": "/icons/favicon-16.png",
      "permanent": true
    },
    {
      "source": "/favicon-32.png",
      "destination": "/icons/favicon-32.png",
      "permanent": true
    },
    {
      "source": "/favicon-48.png",
      "destination": "/icons/favicon-48.png",
      "permanent": true
    },
    {
      "source": "/icon-180.png",
      "destination": "/icons/icon-180.png",
      "permanent": true
    },
    {
      "source": "/icon-192.png",
      "destination": "/icons/icon-192.png",
      "permanent": true
    },
    {
      "source": "/icon-512.png",
      "destination": "/icons/icon-512.png",
      "permanent": true
    },
    {
      "source": "/og-image.png",
      "destination": "/img/og-image.png",
      "permanent": true
    },
    {
      "source": "/chart.umd.js",
      "destination": "/vendor/chart.umd.js",
      "permanent": true
    },
    {
      "source": "/supabase.umd.js",
      "destination": "/vendor/supabase.umd.js",
      "permanent": true
    },
    {
      "source": "/legal.css",
      "destination": "/css/legal.css",
      "permanent": true
    },
    {
      "source": "/contenu.css",
      "destination": "/css/contenu.css",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://sqfkllijmeuoosvgesqi.supabase.co; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/chart.umd.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/supabase.umd.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
